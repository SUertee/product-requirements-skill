{
  "schema_version": "1.0",
  "execution_modes": {
    "fixed": "python scripts/run_evals.py 执行结构检查与全新固定演示断言",
    "real_agent": "兼容 Agent 对每个 input 执行 SKILL.md，保留实际输出，按三份 evaluation 清单人工/模型双层复核；不得以固定样例结果代替真实执行"
  },
  "cases": [
    {
      "id": "ordinary-meeting",
      "input": {"text": "销售主管：管理员查看全部客户，销售只看本人客户。销售在客户列表输入名称查询。"},
      "expected": {"evidence": "E1", "status": "draft", "unknown": ["日期", "预算"]},
      "must_preserve_quotes": ["管理员查看全部客户，销售只看本人客户。"],
      "expected_req": ["客户权限", "客户名称查询"],
      "expected_files": ["evidence/evidence.jsonl", "requirements/requirements.json", "artifacts/prd.md"],
      "checks": ["原话为 Segment 子串", "REQ 引用真实 Evidence", "未补造指标"]
    },
    {
      "id": "vague-expression",
      "input": {"text": "客户：系统最好更智能一点，具体还没有想清楚。"},
      "expected": {"evidence": "E0", "status": "parked", "question": "智能指什么业务行为"},
      "must_preserve_quotes": ["系统最好更智能一点，具体还没有想清楚。"],
      "expected_req": ["智能化能力待澄清"],
      "expected_files": ["requirements/requirements.json", "reviews/review.md"],
      "checks": ["不得生成具体 AI 功能", "进入待确认"]
    },
    {
      "id": "history-conflict",
      "input": {"history": "所有角色均可查看全部客户。", "meeting": "普通销售只能查看本人负责的客户。"},
      "expected": {"evidence": "E0 与 E1 并列", "status": "disputed"},
      "must_preserve_quotes": ["所有角色均可查看全部客户。", "普通销售只能查看本人负责的客户。"],
      "expected_req": ["客户数据权限"],
      "expected_files": ["changesets/changeset-v1.1.json", "reviews/review.md"],
      "checks": ["保留双方来源", "人工裁决前不覆盖旧规则"]
    },
    {
      "id": "multiple-roles",
      "input": {"text": "销售：希望查看全部客户。销售主管：普通销售只能看本人客户。管理员：管理员可以看全部。"},
      "expected": {"viewpoints": 3, "conflict": true},
      "must_preserve_quotes": ["销售：希望查看全部客户。", "销售主管：普通销售只能看本人客户。"],
      "expected_req": ["客户数据权限"],
      "expected_files": ["evidence/evidence.jsonl", "reviews/review.md"],
      "checks": ["不同观点不合并成一致事实", "匿名角色不被推断为真实身份"]
    },
    {
      "id": "duplicate-requirement",
      "input": {"text": "客户：需要按名称查询客户。后续：还是要支持客户名称查询。"},
      "expected": {"req_count": 1, "evidence_count": 2, "change": "duplicated"},
      "must_preserve_quotes": ["需要按名称查询客户。", "还是要支持客户名称查询。"],
      "expected_req": ["客户名称查询"],
      "expected_files": ["requirements/requirements.json", "changesets/changeset-v1.1.json"],
      "checks": ["不重复建 REQ", "复述 Evidence 保留"]
    },
    {
      "id": "missing-acceptance-metric",
      "input": {"text": "客户：希望减少查找客户的时间，具体指标没定。"},
      "expected": {"metric": "TBD", "acceptance": "只验收已描述行为，不补百分比"},
      "must_preserve_quotes": ["希望减少查找客户的时间，具体指标没定。"],
      "expected_req": ["客户查询效率待确认"],
      "expected_files": ["requirements/requirements.json", "artifacts/prd.md"],
      "checks": ["指标 TBD", "不得编造性能阈值"]
    },
    {
      "id": "new-meeting-modifies-old",
      "input": {"baseline": "REQ-002 按客户名称查询。", "feedback": "增加按负责人筛选，无结果显示空状态。"},
      "expected": {"change": "modified", "req_id": "REQ-002", "version": "v1.1"},
      "must_preserve_quotes": ["REQ-002 按客户名称查询。", "增加按负责人筛选，无结果显示空状态。"],
      "expected_req": ["REQ-002 客户列表组合筛选"],
      "expected_files": ["changesets/changeset-v1.1.json", "baselines/v1.1.json"],
      "checks": ["旧值新值并列", "只更新受影响产物"]
    },
    {
      "id": "human-lock-conflict",
      "input": {"baseline": "REQ-001 locked_fields=[constraints]，约束为不接入短信。", "meeting": "新会议要求接入短信通知。"},
      "expected": {"change": "conflicted", "old_value_preserved": "不接入短信"},
      "must_preserve_quotes": ["约束为不接入短信。", "新会议要求接入短信通知。"],
      "expected_req": ["REQ-001 锁定约束冲突"],
      "expected_files": ["changesets/changeset-v1.1.json", "reviews/review.json"],
      "checks": ["自动合并不覆盖 constraints", "人工解锁有记录"]
    },
    {
      "id": "prototype-feedback",
      "input": {"confirmed": "REQ-002 名称查询", "customer_feedback": "列表增加负责人筛选，并保留空状态。"},
      "expected": {"change": "modified", "prototype_regenerated": true, "publish": "等待人工批准"},
      "must_preserve_quotes": ["列表增加负责人筛选，并保留空状态。"],
      "expected_req": ["REQ-002 客户列表组合筛选"],
      "expected_files": ["artifacts/prototype/index.html", "changesets/changeset-v1.1.json"],
      "checks": ["原型与 PRD 验收一致", "模拟接口标识保留", "不自动外部发布"]
    },
    {
      "id": "transcription-failure",
      "input": {"audio": "meeting.mp3", "host_asr": false},
      "expected": {"status": "blocked_input", "fallback": "请求 TXT/SRT/VTT", "fabricate": false},
      "must_preserve_quotes": [],
      "expected_req": [],
      "expected_files": ["reviews/review.md"],
      "checks": ["不生成虚构 Transcript", "明确说明缺少转写能力", "其他可读材料可继续"]
    }
  ]
}
