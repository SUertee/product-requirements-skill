{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckBrief",
  "type": "object",
  "required": ["schema_version", "project_id", "version", "baseline_id", "review_status", "export_status", "audience", "objective", "slides", "output_paths"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "baseline_id": {"type": ["string", "null"]},
    "review_status": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
    "export_status": {"type": "string", "enum": ["not_exported", "exported", "failed"]},
    "audience": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide_id", "title", "purpose", "content", "requirement_ids"],
        "properties": {
          "slide_id": {"type": "string", "pattern": "^SLIDE-"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "content": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}},
          "visual_hint": {"type": "string"},
          "source_paths": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "output_paths": {"type": "array", "items": {"type": "string"}}
  }
}
