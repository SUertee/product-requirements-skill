{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechnicalDesign",
  "type": "object",
  "required": ["schema_version", "project_id", "version", "status", "summary", "decisions", "diagrams", "pending_questions"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
    "summary": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision_id", "title", "decision", "status", "requirement_ids"],
        "properties": {
          "decision_id": {"type": "string", "pattern": "^TD-"},
          "title": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "rationale": {"type": "string"},
          "status": {"type": "string", "enum": ["proposed", "accepted", "rejected", "superseded"]},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}}
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["diagram_id", "diagram_type", "title", "status", "requirement_ids"],
        "properties": {
          "diagram_id": {"type": "string", "pattern": "^DIA-"},
          "diagram_type": {"type": "string", "enum": ["architecture", "sequence", "er", "flowchart", "state", "class", "data_flow"]},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["draft", "generated", "verified", "failed"]},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}},
          "spec_path": {"type": "string"},
          "drawio_path": {"type": "string"},
          "png_path": {"type": "string"},
          "generator": {"type": "string"},
          "validation_results": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "pending_questions": {"type": "array", "items": {"type": "string"}}
  }
}
