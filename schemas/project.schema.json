{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project",
  "type": "object",
  "required": ["schema_version", "project_id", "project_name", "customer", "description", "current_baseline_id", "current_version", "status", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "project_name": {"type": "string"},
    "customer": {"type": "string"},
    "description": {"type": "string"},
    "current_baseline_id": {"type": ["string", "null"]},
    "current_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["draft", "in_review", "baselined", "published"]},
    "context_sources": {"type": "array", "items": {"type": "string"}},
    "requirement_profile": {"type": "object"},
    "design_context": {"type": "object"},
    "prototype_flow": {"type": "object"},
    "prototype_pages": {"type": "array", "items": {"type": "object"}},
    "generation_mode": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
