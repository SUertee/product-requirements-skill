{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact",
  "type": "object",
  "required": ["schema_version", "artifact_id", "project_id", "artifact_type", "artifact_path", "version", "requirement_ids", "generation_status", "review_status", "created_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "artifact_id": {"type": "string", "pattern": "^ART-"},
    "project_id": {"type": "string"},
    "artifact_type": {"type": "string", "enum": ["proposal", "prd", "agent_prompt", "workbench", "prototype", "business_model", "review", "technical_design", "schedule", "deck_brief", "deck", "diagram"]},
    "artifact_path": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}},
    "generation_status": {"type": "string", "enum": ["success", "partial", "failed"]},
    "review_status": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
    "created_at": {"type": "string"}
  }
}
