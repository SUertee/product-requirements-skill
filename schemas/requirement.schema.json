{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "type": "object",
  "required": ["schema_version", "requirement_id", "project_id", "title", "description", "customer_role", "business_scenario", "pain_point", "trigger", "expected_result", "scope", "constraints", "dependencies", "acceptance_criteria", "priority", "evidence_ids", "evidence_level", "status", "locked_by_human", "locked_fields", "pending_questions", "version", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
    "project_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "customer_role": {"type": "string"},
    "business_scenario": {"type": "string"},
    "pain_point": {"type": "string"},
    "trigger": {"type": "string"},
    "expected_result": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string"}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "priority": {"type": "string"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EVD-"}},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3"]},
    "status": {"type": "string", "enum": ["draft", "confirmed", "disputed", "parked"]},
    "locked_by_human": {"type": "boolean"},
    "locked_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "pending_questions": {"type": "array", "items": {"type": "string"}},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  }
}
