{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline",
  "type": "object",
  "required": ["schema_version", "baseline_id", "project_id", "version", "status", "confirmed_requirements", "confirmed_at", "confirmed_by", "simulated_confirmation"],
  "properties": {
    "schema_version": {"type": "string"},
    "baseline_id": {"type": "string", "pattern": "^BASE-"},
    "project_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["frozen", "superseded"]},
    "confirmed_requirements": {"type": "array", "items": {"$ref": "requirement.schema.json"}},
    "confirmed_at": {"type": "string"},
    "confirmed_by": {"type": "string", "minLength": 1},
    "simulated_confirmation": {"type": "boolean"}
  }
}
