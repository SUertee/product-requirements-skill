{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": ["schema_version", "evidence_id", "project_id", "source_id", "segment_id", "start_time", "end_time", "original_quote", "evidence_level", "source_type", "is_inferred", "created_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "evidence_id": {"type": "string", "pattern": "^EVD-"},
    "project_id": {"type": "string"},
    "source_id": {"type": "string", "pattern": "^SRC-"},
    "segment_id": {"type": "string", "pattern": "^SEG-"},
    "start_time": {"type": ["number", "null"]},
    "end_time": {"type": ["number", "null"]},
    "original_quote": {"type": "string", "minLength": 1},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3"]},
    "source_type": {"type": "string"},
    "is_inferred": {"type": "boolean"},
    "created_at": {"type": "string"}
  }
}
