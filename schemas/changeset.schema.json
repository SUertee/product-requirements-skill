{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeSet",
  "type": "object",
  "required": ["schema_version", "changeset_id", "project_id", "old_baseline_id", "new_baseline_id", "added", "modified", "cancelled", "conflicted", "duplicated", "impact_analysis", "review_status", "created_at"],
  "properties": {
    "schema_version": {"type": "string"},
    "changeset_id": {"type": "string", "pattern": "^CHANGE-"},
    "project_id": {"type": "string"},
    "old_baseline_id": {"type": "string"},
    "new_baseline_id": {"type": "string"},
    "added": {"type": "array", "items": {"type": "object"}},
    "modified": {"type": "array", "items": {"type": "object"}},
    "cancelled": {"type": "array", "items": {"type": "object"}},
    "conflicted": {"type": "array", "items": {"type": "object"}},
    "duplicated": {"type": "array", "items": {"type": "object"}},
    "impact_analysis": {"type": "array", "items": {"type": "string"}},
    "review_status": {"type": "string", "enum": ["draft", "approved", "rejected"]},
    "created_at": {"type": "string"}
  }
}
