{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeliveryPlan",
  "type": "object",
  "required": ["schema_version", "project_id", "version", "status", "items", "assumptions"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "status": {"type": "string", "enum": ["draft", "reviewed", "approved"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_id", "title", "requirement_ids", "owner", "start_date", "end_date", "dependencies", "status"],
        "properties": {
          "work_id": {"type": "string", "pattern": "^WORK-"},
          "title": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^REQ-"}, "minItems": 1},
          "owner": {"type": ["string", "null"]},
          "start_date": {"type": ["string", "null"]},
          "end_date": {"type": ["string", "null"]},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^WORK-"}, "uniqueItems": true},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
          "status": {"type": "string", "enum": ["proposed", "confirmed", "in_progress", "completed", "blocked"]}
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
